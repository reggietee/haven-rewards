# Server only. Never prefix any of these with VITE_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace-with-private-spreadsheet-id
# salt:scrypt-64-byte-hex. Generate using npm run setup:operator.
ADMIN_PIN_HASH=replace-with-salt:replace-with-128-character-hex
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Copy device UUID from booth controls after loading the deployed PWA on THE event iPad.
# Required for Sheets writes; pins the fixed-row namespace to one authoritative device.
KIOSK_DEVICE_ID=replace-with-uuid
